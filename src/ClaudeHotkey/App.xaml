<Application x:Class="ClaudeHotkey.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ClaudeHotkey.Views"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Theme.Neptun.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <!-- "UiScale" (the shared ScaleTransform) is added in code at startup, see Views/UiScale.cs -->
            <views:NullToVisibilityConverter x:Key="NullToVisible" />
            <views:NullToVisibilityConverter x:Key="NotNullToVisible" Invert="True" />
            <views:NonEmptyToVisibilityConverter x:Key="NonEmptyToVisible" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
