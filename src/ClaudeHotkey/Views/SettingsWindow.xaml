<Window x:Class="ClaudeHotkey.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClaudeHotkey.Views"
        xmlns:vm="clr-namespace:ClaudeHotkey.ViewModels"
        Title="ClaudeHotkey – Einstellungen"
        Width="880" Height="680" MinWidth="720" MinHeight="520" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSize}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <Style x:Key="Multiline" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="16,8,16,16">
        <!-- Bottom bar -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Schließen" Margin="0,0,8,0" Click="Close_Click" />
                <Button Style="{StaticResource PrimaryButton}" Content="Speichern" Command="{Binding SaveCommand}"
                        ToolTip="Speichern (Strg+S)" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DockPanel>

        <TabControl x:Name="Tabs">
            <!-- Actions -->
            <TabItem Header="Aktionen">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Neu" Margin="0,0,4,0" Command="{Binding NewCommand}" />
                                <Button Content="Duplizieren" Margin="0,0,4,0" Command="{Binding DuplicateCommand}" />
                                <Button Content="Löschen" Command="{Binding DeleteCommand}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="↑" Width="36" Padding="0" Margin="0,0,4,0" ToolTip="Nach oben" Command="{Binding MoveUpCommand}" />
                                <Button Content="↓" Width="36" Padding="0" ToolTip="Nach unten" Command="{Binding MoveDownCommand}" />
                                <TextBlock Style="{StaticResource Muted}" Text="oder ziehen" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <ListBox x:Name="ActionList" ItemsSource="{Binding Actions}" SelectedItem="{Binding Selected}" AllowDrop="True"
                                 PreviewMouseLeftButtonDown="ActionList_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="ActionList_PreviewMouseMove" Drop="ActionList_Drop" DragOver="ActionList_DragOver">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ActionEditorViewModel}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="●" Foreground="{DynamicResource DangerBrush}" Margin="6,0,0,0"
                                                   ToolTip="Hat Fehler"
                                                   Visibility="{Binding Errors.Any, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <TextBlock Grid.Column="2" Style="{StaticResource Muted}" Text="Keine Aktion ausgewählt. Mit „Neu“ eine anlegen."
                               Visibility="{Binding Selected, Converter={StaticResource NullToVisible}}" />

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" DataContext="{Binding Selected}"
                                  Visibility="{Binding Converter={StaticResource NotNullToVisible}}">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Name (Button im Popup)" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[label]}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" FontSize="12">
                                <Run Text="Kennung:" /> <Run Text="{Binding Id, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[id]}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Prompt (Anweisung an Claude)" />
                            <TextBox Style="{StaticResource Multiline}" Height="110" Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="Der markierte Text wird getrennt übergeben. {input} wird durch die Eingabe im Popup ersetzt (mit „Eingabefeld im Popup“)." />
                            <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[prompt]}" />

                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Modell" />
                                    <ComboBox IsEditable="True" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                                              ItemsSource="{Binding DataContext.Models, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" Text="Leer = Standardmodell aus „Allgemein“" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Eigener Hotkey (optional)" />
                                    <local:HotkeyTextBox Style="{StaticResource {x:Type TextBox}}" Text="{Binding Hotkey}" />
                                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="Anklicken und Kombination drücken, für Doppeldruck die Taste zweimal (z. B. Strg+X+X). Entf löscht. Führt die Aktion direkt aus." />
                                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[hotkey]}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,14,0,0">
                                <CheckBox Content="Ersetzen-Button anzeigen" IsChecked="{Binding Replace}" />
                                <CheckBox Content="Eingabefeld im Popup" IsChecked="{Binding AskInput}" Margin="0,10,0,0" />
                                <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[askInput]}" />
                                <CheckBox Content="Aktiv (im Popup anzeigen)" IsChecked="{Binding Enabled}" Margin="0,10,0,0" />
                            </StackPanel>

                            <!-- Try the action without leaving the dialog -->
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Heading}" Text="Testen" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="Beispieltext" />
                                    <TextBox Style="{StaticResource Multiline}" Height="60" Text="{Binding TestText, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel Visibility="{Binding AskInput, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="Eingabe im Popup ({input})" />
                                        <TextBox Text="{Binding TestInput, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="Testen" Command="{Binding TestCommand}" Margin="0,0,8,0" />
                                        <Button Content="Abbrechen" Command="{Binding CancelTestCommand}"
                                                Visibility="{Binding IsTesting, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <ProgressBar Style="{StaticResource BusyBar}" Margin="0,8,0,0"
                                                 Visibility="{Binding IsTesting, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBox Style="{StaticResource ReadOnlyText}" Text="{Binding TestResult, Mode=OneWay}" Margin="0,8,0,0"
                                             MaxHeight="200" Visibility="{Binding TestResult, Converter={StaticResource NonEmptyToVisible}}" />
                                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding TestError}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- General -->
            <TabItem Header="Allgemein">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel MaxWidth="640" HorizontalAlignment="Left" Margin="0,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Zeitfenster für Doppeldruck (ms)" Margin="0,0,0,4" />
                            <TextBox Text="{Binding DoubleCopyMs, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource FieldError}" Text="{Binding GeneralErrors[doubleCopyMs]}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Standardmodell" />
                            <ComboBox IsEditable="True" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding Models}" />
                            <TextBlock Style="{StaticResource FieldError}" Text="{Binding GeneralErrors[model]}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Wartezeit beim Einfügen (ms)" />
                            <TextBox Text="{Binding PasteDelayMs, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="Erhöhen, wenn ein Programm beim Ersetzen noch den alten Text einfügt." />
                            <TextBlock Style="{StaticResource FieldError}" Text="{Binding GeneralErrors[pasteDelayMs]}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="Haupt-Hotkey (öffnet das Popup)" Margin="0,0,0,4" />
                            <local:HotkeyTextBox Style="{StaticResource {x:Type TextBox}}" Text="{Binding MainHotkey}" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="Standard Strg+C+C. Für Doppeldruck die Taste zweimal drücken. Bei Strg+C+C und Strg+X+X kopiert das Programm selbst, sonst kopiert das Tool und stellt die Zwischenablage wieder her." />
                            <TextBlock Style="{StaticResource FieldError}" Text="{Binding GeneralErrors[mainHotkey]}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Timeout (Sekunden)" />
                            <TextBox Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource FieldError}" Text="{Binding GeneralErrors[timeoutSeconds]}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Pfad zur Claude-CLI (optional)" />
                            <TextBox Text="{Binding ClaudePath, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" Text="Leer = claude.exe im PATH suchen" />
                        </StackPanel>

                    </Grid>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="System-Prompt (gilt für alle Aktionen)" Margin="0,14,0,4" />
                    <TextBox Style="{StaticResource Multiline}" Height="90" Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}" />

                    <CheckBox Content="Mit Windows starten" IsChecked="{Binding Autostart}" Margin="0,16,0,0" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="40,4,0,0" TextWrapping="Wrap"
                               Text="Beim Speichern wird dieses Programm unter HKCU\…\Run eingetragen bzw. wieder entfernt. Am besten aus der veröffentlichten .exe einschalten, nicht aus einem Test-Build." />
                  </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
