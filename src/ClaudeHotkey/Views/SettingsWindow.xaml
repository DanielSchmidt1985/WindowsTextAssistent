<Window x:Class="ClaudeHotkey.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClaudeHotkey.Views"
        xmlns:vm="clr-namespace:ClaudeHotkey.ViewModels"
        xmlns:l="clr-namespace:ClaudeHotkey.Localization"
        Title="{x:Static l:Ui.SettingsTitle}"
        Width="880" Height="680" MinWidth="720" MinHeight="520" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSize}"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="Multiline" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="16,8,16,16" LayoutTransform="{DynamicResource UiScale}">
        <!-- Bottom bar -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="{x:Static l:Ui.Close}" Margin="0,0,8,0" Click="Close_Click" />
                <Button Style="{StaticResource PrimaryButton}" Content="{x:Static l:Ui.Save}" Command="{Binding SaveCommand}"
                        ToolTip="{x:Static l:Ui.SaveTip}" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DockPanel>

        <TabControl x:Name="Tabs">
            <!-- Actions -->
            <TabItem Header="{x:Static l:Ui.TabActions}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0">
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{x:Static l:Ui.New}" Margin="0,0,4,0" Command="{Binding NewCommand}" />
                                <Button Content="{x:Static l:Ui.Duplicate}" Margin="0,0,4,0" Command="{Binding DuplicateCommand}" />
                                <Button Content="{x:Static l:Ui.Delete}" Command="{Binding DeleteCommand}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                <Button Content="↑" Width="36" Padding="0" Margin="0,0,4,0" ToolTip="{x:Static l:Ui.MoveUp}" Command="{Binding MoveUpCommand}" />
                                <Button Content="↓" Width="36" Padding="0" ToolTip="{x:Static l:Ui.MoveDown}" Command="{Binding MoveDownCommand}" />
                                <TextBlock Style="{StaticResource Muted}" Text="{x:Static l:Ui.OrDrag}" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <ListBox x:Name="ActionList" ItemsSource="{Binding Actions}" SelectedItem="{Binding Selected}" AllowDrop="True"
                                 PreviewMouseLeftButtonDown="ActionList_PreviewMouseLeftButtonDown"
                                 PreviewMouseMove="ActionList_PreviewMouseMove" Drop="ActionList_Drop" DragOver="ActionList_DragOver">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ActionEditorViewModel}">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="●" Foreground="{DynamicResource DangerBrush}" Margin="6,0,0,0"
                                                   ToolTip="{x:Static l:Ui.HasErrors}"
                                                   Visibility="{Binding Errors.Any, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <TextBlock Grid.Column="2" Style="{StaticResource Muted}" Text="{x:Static l:Ui.NoActionSelected}"
                               Visibility="{Binding Selected, Converter={StaticResource NullToVisible}}" />

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" DataContext="{Binding Selected}"
                                  Visibility="{Binding Converter={StaticResource NotNullToVisible}}">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static l:Ui.LabelField}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[label]}" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" FontSize="12">
                                <Run Text="{x:Static l:Ui.IdLabel}" /> <Run Text="{Binding Id, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[id]}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static l:Ui.PromptField}" />
                            <TextBox Style="{StaticResource Multiline}" Height="110" Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="{x:Static l:Ui.PromptHint}" />
                            <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[prompt]}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static l:Ui.FeedbackField}" />
                            <TextBox Style="{StaticResource Multiline}" Height="60" Text="{Binding Feedback, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="{x:Static l:Ui.FeedbackHint}" />

                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static l:Ui.ModelField}" />
                                    <ComboBox IsEditable="True" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}"
                                              ItemsSource="{Binding DataContext.Models, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" Text="{x:Static l:Ui.ModelHint}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static l:Ui.ActionHotkeyField}" />
                                    <local:HotkeyTextBox Style="{StaticResource {x:Type TextBox}}" Text="{Binding Hotkey}" />
                                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="{x:Static l:Ui.ActionHotkeyHint}" />
                                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[hotkey]}" />
                                </StackPanel>
                            </Grid>

                            <StackPanel Margin="0,14,0,0">
                                <CheckBox Content="{x:Static l:Ui.ShowReplace}" IsChecked="{Binding Replace}" />
                                <CheckBox Content="{x:Static l:Ui.AskInputCheck}" IsChecked="{Binding AskInput}" Margin="0,10,0,0" />
                                <TextBlock Style="{StaticResource FieldError}" Text="{Binding Errors[askInput]}" />
                                <CheckBox Content="{x:Static l:Ui.EnabledCheck}" IsChecked="{Binding Enabled}" Margin="0,10,0,0" />
                            </StackPanel>

                            <!-- Try the action without leaving the dialog -->
                            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Heading}" Text="{x:Static l:Ui.Test}" />
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static l:Ui.SampleText}" />
                                    <TextBox Style="{StaticResource Multiline}" Height="60" Text="{Binding TestText, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel Visibility="{Binding AskInput, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static l:Ui.TestInputField}" />
                                        <TextBox Text="{Binding TestInput, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="{x:Static l:Ui.Test}" Command="{Binding TestCommand}" Margin="0,0,8,0" />
                                        <Button Content="{x:Static l:Ui.Cancel}" Command="{Binding CancelTestCommand}"
                                                Visibility="{Binding IsTesting, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <ProgressBar Style="{StaticResource BusyBar}" Margin="0,8,0,0"
                                                 Visibility="{Binding IsTesting, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBox Style="{StaticResource ReadOnlyText}" Text="{Binding TestResult, Mode=OneWay}" Margin="0,8,0,0"
                                             MaxHeight="200" Visibility="{Binding TestResult, Converter={StaticResource NonEmptyToVisible}}" />
                                    <Border Margin="0,8,0,0" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2,0,0,0" Padding="10,0,0,0"
                                            Visibility="{Binding TestFeedback, Converter={StaticResource NonEmptyToVisible}}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Muted}" Text="FEEDBACK" FontSize="11" FontWeight="SemiBold" />
                                            <TextBox Style="{StaticResource ReadOnlyText}" Text="{Binding TestFeedback, Mode=OneWay}" Margin="-4,2,0,0"
                                                     MaxHeight="200" Background="Transparent" BorderThickness="0" Padding="4,2" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Style="{StaticResource FieldError}" Text="{Binding TestError}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- General -->
            <TabItem Header="{x:Static l:Ui.TabGeneral}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel MaxWidth="640" HorizontalAlignment="Left" Margin="0,0,8,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static l:Ui.DoubleCopyField}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding DoubleCopyMs, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource FieldError}" Text="{Binding GeneralErrors[doubleCopyMs]}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static l:Ui.DefaultModelField}" />
                            <ComboBox IsEditable="True" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" ItemsSource="{Binding Models}" />
                            <TextBlock Style="{StaticResource FieldError}" Text="{Binding GeneralErrors[model]}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static l:Ui.PasteDelayField}" />
                            <TextBox Text="{Binding PasteDelayMs, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="{x:Static l:Ui.PasteDelayHint}" />
                            <TextBlock Style="{StaticResource FieldError}" Text="{Binding GeneralErrors[pasteDelayMs]}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static l:Ui.MainHotkeyField}" Margin="0,0,0,4" />
                            <local:HotkeyTextBox Style="{StaticResource {x:Type TextBox}}" Text="{Binding MainHotkey}" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="{x:Static l:Ui.MainHotkeyHint}" />
                            <TextBlock Style="{StaticResource FieldError}" Text="{Binding GeneralErrors[mainHotkey]}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static l:Ui.TimeoutField}" />
                            <TextBox Text="{Binding TimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource FieldError}" Text="{Binding GeneralErrors[timeoutSeconds]}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static l:Ui.ClaudePathField}" />
                            <TextBox Text="{Binding ClaudePath, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" Text="{x:Static l:Ui.ClaudePathHint}" />
                        </StackPanel>

                    </Grid>

                    <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static l:Ui.SystemPromptField}" Margin="0,14,0,4" />
                    <TextBox Style="{StaticResource Multiline}" Height="90" Text="{Binding SystemPrompt, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Style="{StaticResource Heading}" Text="{x:Static l:Ui.Appearance}" Margin="0,18,0,0" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static l:Ui.ThemeField}" />
                            <ComboBox ItemsSource="{Binding ThemeChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding Theme}" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="{x:Static l:Ui.ThemeHint}" />
                            <TextBlock Style="{StaticResource FieldError}" Text="{Binding GeneralErrors[theme]}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static l:Ui.LanguageField}" />
                            <ComboBox ItemsSource="{Binding LanguageChoices}" DisplayMemberPath="Label" SelectedValuePath="Value"
                                      SelectedValue="{Binding Language}" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="{x:Static l:Ui.LanguageHint}" />
                            <TextBlock Style="{StaticResource FieldError}" Text="{Binding GeneralErrors[language]}" />
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static l:Ui.ScaleField}" />
                            <TextBox Text="{Binding Scale, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="{x:Static l:Ui.ScaleHint}" />
                            <TextBlock Style="{StaticResource FieldError}" Text="{Binding GeneralErrors[scale]}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static l:Ui.PopupWidthField}" />
                            <TextBox Text="{Binding PopupWidth, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="{x:Static l:Ui.PopupWidthHint}" />
                            <TextBlock Style="{StaticResource FieldError}" Text="{Binding GeneralErrors[popupWidth]}" />
                        </StackPanel>
                    </Grid>

                    <CheckBox Content="{x:Static l:Ui.Autostart}" IsChecked="{Binding Autostart}" Margin="0,18,0,0" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="40,4,0,0" TextWrapping="Wrap"
                               Text="{x:Static l:Ui.AutostartHint}" />

                    <CheckBox Content="{x:Static l:Ui.AutoUpdate}" IsChecked="{Binding AutoUpdate}" Margin="0,14,0,0" />
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="40,4,0,0" TextWrapping="Wrap"
                               Text="{x:Static l:Ui.AutoUpdateHint}" />
                  </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
