<Window x:Class="ClaudeHotkey.Views.CaptureLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClaudeHotkey – Textübernahme testen (Phase 2)"
        Width="560" Height="460" Topmost="True" ShowActivated="False"
        FontFamily="Segoe UI" FontSize="13">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="PreflightText" Text="Preflight läuft …" />
            <TextBlock x:Name="HotkeyText" Margin="0,4,0,0" />
            <TextBlock Margin="0,8,0,8" TextWrapping="Wrap" Foreground="Gray"
                       Text="Text in einem anderen Programm markieren, dann Strg+C+C oder den zweiten Hotkey drücken. Schließen beendet das Tool." />
        </StackPanel>
        <ListBox x:Name="Log" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,4">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Header}" />
                        <TextBlock Text="{Binding Body}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Clipboard}" TextWrapping="Wrap" Foreground="Gray" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
