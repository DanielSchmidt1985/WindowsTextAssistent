<Window x:Class="ClaudeHotkey.Views.CaptureLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ClaudeHotkey – Status (bis zum Tray-Icon in Phase 6)"
        Width="560" Height="420" ShowActivated="False"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSize}">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Content="Einstellungen …" Click="Settings_Click" Margin="0,0,0,8" />
            <TextBlock x:Name="PreflightText" Text="Preflight läuft …" />
            <TextBlock x:Name="HotkeyText" Margin="0,4,0,0" />
            <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,8" TextWrapping="Wrap"
                       Text="Text in einem anderen Programm markieren, dann Strg+C+C oder den zweiten Hotkey drücken. Schließen beendet das Tool." />
        </StackPanel>
        <ListBox x:Name="Log" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                 Foreground="{DynamicResource TextBrush}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="0,4">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Header}" />
                        <TextBlock Text="{Binding Body}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Muted}" Text="{Binding Clipboard}" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
