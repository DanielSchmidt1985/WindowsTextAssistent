<Window x:Class="ClaudeHotkey.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ClaudeHotkey.ViewModels"
        xmlns:l="clr-namespace:ClaudeHotkey.Localization"
        Title="ClaudeHotkey"
        Width="464" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSize}"
        Foreground="{DynamicResource TextBrush}" UseLayoutRounding="True">
    <!-- 12 px transparent margin leaves room for the shadow; UiScale scales everything inside -->
    <Border Margin="12" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="{StaticResource PopupRadius}" LayoutTransform="{DynamicResource UiScale}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.45" Color="Black" />
        </Border.Effect>
        <Grid>
        <!-- Right edge: drag to change the width (remembered in ui.json) -->
        <Thumb x:Name="WidthGrip" HorizontalAlignment="Right" Width="6" Cursor="SizeWE" Panel.ZIndex="1"
               ToolTip="{x:Static l:Ui.DragWidth}" DragDelta="WidthGrip_DragDelta" DragCompleted="WidthGrip_DragCompleted">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
        <StackPanel Margin="12,8,12,12">

            <!-- Header: drag area, text size, close -->
            <DockPanel x:Name="Header" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="✕" FontSize="11"
                        ToolTip="{x:Static l:Ui.CloseEsc}" Click="Close_Click" IsTabStop="False" />
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="⚙" FontSize="14"
                        ToolTip="{x:Static l:Ui.Settings}" Click="Settings_Click" IsTabStop="False" />
                <TextBlock Style="{StaticResource Heading}" Text="Claude" VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource Muted}" Text="{Binding SourceInfo}" Margin="8,0,0,0" VerticalAlignment="Center" />
            </DockPanel>

            <TextBlock Style="{StaticResource Muted}" Text="{Binding SourcePreview}" TextTrimming="CharacterEllipsis"
                       Margin="0,4,0,0" Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibility}}" />

            <!-- Action buttons from actions.json; digits 1–9 run them -->
            <ItemsControl ItemsSource="{Binding Actions}" Margin="0,8,0,0" Focusable="False"
                          Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ActionItem}">
                        <Button Content="{Binding Label}" ToolTip="{Binding ToolTip}" Margin="0,0,4,4"
                                Command="{Binding DataContext.RunActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Free-text instruction (askInput) -->
            <DockPanel Margin="0,4,0,0" Visibility="{Binding IsAskingInput, Converter={StaticResource BoolToVisibility}}">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{x:Static l:Ui.Run}" Margin="4,0,0,0"
                        Command="{Binding SubmitInputCommand}" />
                <TextBox x:Name="InputBox" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{x:Static l:Ui.InputTip}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SubmitInputCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>

            <!-- Running -->
            <StackPanel Margin="0,8,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                <!-- The answer while it is written; the result box below takes over when it is done -->
                <TextBox x:Name="StreamBox" Style="{StaticResource ReadOnlyText}" Text="{Binding StreamingText, Mode=OneWay}" Margin="0,-4,0,8"
                         MaxHeight="320" Visibility="{Binding HasStreamingText, Converter={StaticResource BoolToVisibility}}" />
                <ProgressBar Style="{StaticResource BusyBar}" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0">
                    <Run Text="{Binding RunningLabel, Mode=OneWay}" /><Run Text="{x:Static l:Ui.EscCancels}" />
                </TextBlock>
            </StackPanel>

            <!-- Versions: the action's result and one per follow-up; a chip or the arrows show an older one -->
            <DockPanel Margin="0,6,0,0" Visibility="{Binding HasVersions, Converter={StaticResource BoolToVisibility}}">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource IconButton}" Content="‹" FontSize="16" Height="22" ToolTip="{x:Static l:Ui.PreviousVersion}"
                            Command="{Binding PreviousVersionCommand}" IsTabStop="False" />
                    <TextBlock Style="{StaticResource Muted}" Text="{Binding VersionInfo}" VerticalAlignment="Center" Margin="2,0" />
                    <Button Style="{StaticResource IconButton}" Content="›" FontSize="16" Height="22" ToolTip="{x:Static l:Ui.NextVersion}"
                            Command="{Binding NextVersionCommand}" IsTabStop="False" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Steps}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:StepItem}">
                            <Button x:Name="Chip" Style="{StaticResource ChipButton}" Margin="0,0,4,4" ToolTip="{Binding Label}" IsTabStop="False"
                                    Command="{Binding DataContext.SelectVersionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="Chip" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>

            <!-- Result -->
            <TextBox x:Name="ResultBox" Style="{StaticResource ReadOnlyText}" Text="{Binding ResultText, Mode=OneWay}" Margin="0,4,0,0"
                     MaxHeight="320" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}" />

            <!-- Feedback: for reading only, "Ersetzen" and "Kopieren" take the result above -->
            <Border Margin="0,10,0,0" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2,0,0,0" Padding="10,0,0,0"
                    Visibility="{Binding HasFeedback, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Muted}" Text="FEEDBACK" FontSize="11" FontWeight="SemiBold" />
                    <TextBox x:Name="FeedbackBox" Style="{StaticResource ReadOnlyText}" Text="{Binding FeedbackText, Mode=OneWay}" Margin="-4,2,0,0"
                             MaxHeight="220" Background="Transparent" BorderThickness="0" Padding="4,2" />
                </StackPanel>
            </Border>

            <!-- Follow-up on the shown result ("in Du-Form"); Enter sends it, with an empty field Enter replaces -->
            <DockPanel Margin="0,8,0,0" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                <Button DockPanel.Dock="Right" Content="{x:Static l:Ui.Send}" Margin="4,0,0,0" Command="{Binding RefineCommand}" IsTabStop="False" />
                <Grid>
                    <TextBox x:Name="RefineBox" Text="{Binding RefineText, UpdateSourceTrigger=PropertyChanged}" ToolTip="{x:Static l:Ui.RefineTip}" />
                    <TextBlock Text="{x:Static l:Ui.RefinePlaceholder}" Foreground="{DynamicResource MutedTextBrush}" Margin="9,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RefineText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>

            <!-- Error -->
            <StackPanel Margin="0,8,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
                <Button Style="{StaticResource LinkButton}" Content="Details" Margin="0,6,0,0"
                        Command="{Binding ToggleDetailsCommand}"
                        Visibility="{Binding HasErrorDetails, Converter={StaticResource BoolToVisibility}}" />
                <TextBox Style="{StaticResource ReadOnlyText}" Text="{Binding ErrorDetails, Mode=OneWay}" Margin="0,6,0,0"
                         MaxHeight="200" FontFamily="Consolas" FontSize="12"
                         Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <TextBlock Text="{Binding ReplaceError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Visibility="{Binding HasReplaceError, Converter={StaticResource BoolToVisibility}}" />

            <!-- Footer -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="{x:Static l:Ui.BackToResult}" Margin="0,0,4,0" Command="{Binding BackToResultCommand}"
                        Visibility="{Binding CanReturnToResult, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="{x:Static l:Ui.Retry}" Margin="0,0,4,0" Command="{Binding RetryCommand}"
                        Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="{x:Static l:Ui.Copy}" Margin="0,0,4,0" Command="{Binding CopyCommand}"
                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}" />
                <Button x:Name="ReplaceButton" Style="{StaticResource PrimaryButton}" Content="{x:Static l:Ui.Replace}" IsDefault="True"
                        ToolTip="{x:Static l:Ui.ReplaceTip}" Command="{Binding ReplaceCommand}"
                        Visibility="{Binding CanReplace, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </StackPanel>
        </Grid>
    </Border>
</Window>
