<Window x:Class="ClaudeHotkey.Views.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ClaudeHotkey.ViewModels"
        Title="ClaudeHotkey"
        Width="464" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        FontFamily="{StaticResource UiFont}" FontSize="{StaticResource FontSize}"
        Foreground="{DynamicResource TextBrush}" UseLayoutRounding="True">
    <!-- 12 px transparent margin leaves room for the shadow; UiScale scales everything inside -->
    <Border Margin="12" Background="{DynamicResource BgBrush}" BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="{StaticResource PopupRadius}" LayoutTransform="{DynamicResource UiScale}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.45" Color="Black" />
        </Border.Effect>
        <Grid>
        <!-- Right edge: drag to change the width (remembered in ui.json) -->
        <Thumb x:Name="WidthGrip" HorizontalAlignment="Right" Width="6" Cursor="SizeWE" Panel.ZIndex="1"
               ToolTip="Breite ziehen" DragDelta="WidthGrip_DragDelta" DragCompleted="WidthGrip_DragCompleted">
            <Thumb.Template>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Thumb.Template>
        </Thumb>
        <StackPanel Margin="12,8,12,12">

            <!-- Header: drag area, text size, close -->
            <DockPanel x:Name="Header" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="✕" FontSize="11"
                        ToolTip="Schließen (Esc)" Click="Close_Click" IsTabStop="False" />
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="⚙" FontSize="14"
                        ToolTip="Einstellungen" Click="Settings_Click" IsTabStop="False" />
                <TextBlock Style="{StaticResource Heading}" Text="Claude" VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource Muted}" Text="{Binding SourceInfo}" Margin="8,0,0,0" VerticalAlignment="Center" />
            </DockPanel>

            <TextBlock Style="{StaticResource Muted}" Text="{Binding SourcePreview}" TextTrimming="CharacterEllipsis"
                       Margin="0,4,0,0" Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibility}}" />

            <!-- Action buttons from actions.json; digits 1–9 run them -->
            <ItemsControl ItemsSource="{Binding Actions}" Margin="0,8,0,0" Focusable="False"
                          Visibility="{Binding HasSource, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ActionItem}">
                        <Button Content="{Binding Label}" ToolTip="{Binding ToolTip}" Margin="0,0,4,4"
                                Command="{Binding DataContext.RunActionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Free-text instruction (askInput) -->
            <DockPanel Margin="0,4,0,0" Visibility="{Binding IsAskingInput, Converter={StaticResource BoolToVisibility}}">
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Ausführen" Margin="4,0,0,0"
                        Command="{Binding SubmitInputCommand}" />
                <TextBox x:Name="InputBox" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Anweisung an Claude, Enter führt aus">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SubmitInputCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>

            <!-- Running -->
            <StackPanel Margin="0,8,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}">
                <ProgressBar Style="{StaticResource BusyBar}" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,6,0,0">
                    <Run Text="{Binding RunningLabel, Mode=OneWay}" /><Run Text="  Esc bricht ab" />
                </TextBlock>
            </StackPanel>

            <!-- Result -->
            <TextBox x:Name="ResultBox" Style="{StaticResource ReadOnlyText}" Text="{Binding ResultText, Mode=OneWay}" Margin="0,4,0,0"
                     MaxHeight="320" Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}" />

            <!-- Feedback: for reading only, "Ersetzen" and "Kopieren" take the result above -->
            <Border Margin="0,10,0,0" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2,0,0,0" Padding="10,0,0,0"
                    Visibility="{Binding HasFeedback, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Muted}" Text="FEEDBACK" FontSize="11" FontWeight="SemiBold" />
                    <TextBox x:Name="FeedbackBox" Style="{StaticResource ReadOnlyText}" Text="{Binding FeedbackText, Mode=OneWay}" Margin="-4,2,0,0"
                             MaxHeight="220" Background="Transparent" BorderThickness="0" Padding="4,2" />
                </StackPanel>
            </Border>

            <!-- Error -->
            <StackPanel Margin="0,8,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
                <Button Style="{StaticResource LinkButton}" Content="Details" Margin="0,6,0,0"
                        Command="{Binding ToggleDetailsCommand}"
                        Visibility="{Binding HasErrorDetails, Converter={StaticResource BoolToVisibility}}" />
                <TextBox Style="{StaticResource ReadOnlyText}" Text="{Binding ErrorDetails, Mode=OneWay}" Margin="0,6,0,0"
                         MaxHeight="200" FontFamily="Consolas" FontSize="12"
                         Visibility="{Binding ShowDetails, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>

            <TextBlock Text="{Binding ReplaceError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                       Visibility="{Binding HasReplaceError, Converter={StaticResource BoolToVisibility}}" />

            <!-- Footer -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Erneut versuchen" Margin="0,0,4,0" Command="{Binding RetryCommand}"
                        Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Kopieren" Margin="0,0,4,0" Command="{Binding CopyCommand}"
                        Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}" />
                <Button x:Name="ReplaceButton" Style="{StaticResource PrimaryButton}" Content="Ersetzen" IsDefault="True"
                        ToolTip="Markierten Text im Quellfenster ersetzen (Enter)" Command="{Binding ReplaceCommand}"
                        Visibility="{Binding CanReplace, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </StackPanel>
        </Grid>
    </Border>
</Window>
