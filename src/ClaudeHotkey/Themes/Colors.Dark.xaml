<!-- Dark palette. Every key here must also exist in Colors.Light.xaml (checked by a test). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BgBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#2A2A2A" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3D3D3D" />
    <SolidColorBrush x:Key="TextBrush" Color="#E6E6E6" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#A0A0A0" />
    <SolidColorBrush x:Key="AccentBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2B88D8" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F1707B" />
    <!-- Derived: hover/pressed for bordered controls, kept as tokens so theme.json can tune them -->
    <SolidColorBrush x:Key="HoverBrush" Color="#333333" />
    <SolidColorBrush x:Key="PressedBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#264F78" />
</ResourceDictionary>
